---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

// Drafts are visible in the local live preview (dev) but never published (build).
const all = (await getCollection('posts'))
  .filter(post => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Personal projects get the card grid; work entries live on the career timeline
// and link into it, so they never 404 from here.
const posts = all.filter(p => p.data.type !== 'work');
const workPosts = all.filter(p => p.data.type === 'work').slice(0, 4);

// Co-op terms, newest first, for the badge row.
const MONTH = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const fmt = (ym: string) => {
  const [y, m] = String(ym).split('-').map(Number);
  return MONTH[(m || 1) - 1] + ' ' + String(y).slice(2);
};
const monthsBetween = (a: string, b: string) => {
  const [sy, sm] = String(a).split('-').map(Number);
  const [ey, em] = String(b).split('-').map(Number);
  return Math.max(1, (ey - sy) * 12 + (em - sm) + 1);
};
const workTerms = (((site as any).work?.terms) ?? [])
  .slice()
  .sort((a: any, b: any) => String(b.start).localeCompare(String(a.start)))
  .map((t: any) => ({
    ...t,
    span: fmt(t.start) + ' – ' + fmt(t.end),
    mo: Number(t.months) > 0 ? Number(t.months) : monthsBetween(t.start, t.end),
    initials: String(t.company || '?').replace(/[^A-Za-z0-9 ]/g, '').split(/\s+/)
      .filter(Boolean).slice(0, 2).map((w: string) => w[0].toUpperCase()).join(''),
  }));
---

<BaseLayout>
  <div class="hero">
    <div class="hero-bg" style={`background-image: url('${site.hero.backgroundImage}')`}></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{site.hero.name}</h1>
      <p class="hero-subtitle">{site.hero.subtitle}</p>
      <p class="hero-sub">
        {site.hero.tagline}
      </p>
      <div class="hero-cta">
        <a href={site.hero.primaryButton.href} class="btn btn-primary">{site.hero.primaryButton.label}</a>
        <a href={site.hero.ghostButton.href} class="btn btn-ghost">{site.hero.ghostButton.label}</a>
      </div>
    </div>
  </div>

  <div class="container">
    <section class="section">
      <div class="section-header">
        <h2>Recent Projects</h2>
        <a href="/blog" class="see-all">See all →</a>
      </div>

      <div class="post-grid">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="post-card">
            {post.data.featureImage && (
              <div class="post-card-image">
                <img src={post.data.featureImage} alt={post.data.title} loading="lazy" />
              </div>
            )}
            <div class="post-card-body">
              <div class="post-card-meta">
                {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                <time>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
              </div>
              <h3>{post.data.title}</h3>
              {post.data.description && <p>{post.data.description}</p>}
              <span class="read-more">Read more →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {(workTerms.length > 0 || workPosts.length > 0) && (
      <section class="section">
        <div class="section-header">
          <h2>Work Experience</h2>
          <a href="/career" class="see-all">See all &rarr;</a>
        </div>

        {workTerms.length > 0 && (
          <div class="term-badges">
            {workTerms.map((t: any) => (
              <a href="/career" class="term-badge">
                <span class="term-logo">
                  {t.logo
                    ? <img src={t.logo} alt={t.company} loading="lazy" />
                    : <span class="term-initials">{t.initials}</span>}
                </span>
                <span class="term-info">
                  <span class="term-company">{t.company}</span>
                  <span class="term-role">{t.role}</span>
                  <span class="term-span">{t.span}<span class="term-mo">{t.mo} mo</span></span>
                </span>
              </a>
            ))}
          </div>
        )}
        {workPosts.length > 0 && (
        <div class="work-list">
          {workPosts.map(post => (
            <a href={`/career#entry-${post.slug}`} class="work-row">
              {post.data.featureImage && (
                <span class="work-thumb">
                  <img src={post.data.featureImage} alt="" loading="lazy" />
                </span>
              )}
              <span class="work-body">
                <span class="work-title">{post.data.title}</span>
                {(post.data.summary || post.data.description) && (
                  <span class="work-sum">{post.data.summary || post.data.description}</span>
                )}
              </span>
              <span class="work-arrow">&rarr;</span>
            </a>
          ))}
        </div>
        )}
      </section>
    )}

    <section class="section skills-section">
      <h2>{site.skillsHeading}</h2>
      <div class="skills-grid">
        {site.skills.map(skill => (
          <div class="skill-group">
            <h3>{skill.title}</h3>
            <p>{skill.text}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    height: 92vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 5rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    background-repeat: no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.35) 0%,
      rgba(0,0,0,0.55) 60%,
      rgba(15,15,15,0.95) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 680px;
    padding: 0 1.5rem;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-bottom: 1.5rem;
    margin-top: 0.5rem;
    font-weight: 500;
  }

  .hero-content h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.5rem);
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  .hero-sub {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.75);
    max-width: 520px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #000;
  }
  .btn-primary:hover { opacity: 0.85; }

  .btn-ghost {
    border: 1px solid rgba(255,255,255,0.4);
    color: #fff;
    backdrop-filter: blur(4px);
  }
  .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
  }

  /* ---- Section ---- */
  .section {
    margin-bottom: 5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .section-header h2 { margin: 0; }

  .see-all {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .see-all:hover { color: var(--color-accent); opacity: 1; }

  /* ---- Post grid ---- */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
    color: var(--color-text);
  }

  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    opacity: 1;
  }

  .post-card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .post-card:hover .post-card-image img {
    transform: scale(1.03);
  }

  .post-card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .post-card-meta time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .post-card-body h3 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
    color: #fff;
  }

  .post-card-body p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  /* ---- Co-op term badges ---- */
  .term-badges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .term-badge {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.8rem 0.9rem;
    color: var(--color-text);
    transition: border-color 0.2s, transform 0.15s;
  }
  .term-badge:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    opacity: 1;
  }

  .term-logo {
    flex: 0 0 auto;
    width: 42px; height: 42px;
    border-radius: 7px;
    overflow: hidden;
    display: grid; place-items: center;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }
  .term-logo img { width: 100%; height: 100%; object-fit: contain; display: block; padding: 3px; }
  .term-initials {
    font-size: 0.82rem; font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-accent);
  }

  .term-info { display: flex; flex-direction: column; min-width: 0; gap: 0.1rem; }
  .term-company { font-weight: 600; font-size: 0.92rem; line-height: 1.25; }
  .term-role {
    font-size: 0.78rem; color: var(--color-text-muted); line-height: 1.3;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .term-span {
    display: flex; align-items: center; gap: 0.45rem;
    font-size: 0.74rem; color: var(--color-text-muted); margin-top: 0.15rem;
  }
  .term-mo {
    border: 1px solid var(--color-border);
    background: var(--color-accent-dim);
    color: var(--color-accent);
    border-radius: 999px;
    padding: 0.02rem 0.42rem;
    font-weight: 600;
  }

  /* ---- Recent work rows (compact, distinct from the project cards) ---- */
  .work-list { display: flex; flex-direction: column; gap: 0.6rem; }

  .work-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.8rem 1rem;
    color: var(--color-text);
    transition: border-color 0.2s, transform 0.15s;
  }
  .work-row:hover {
    border-color: var(--color-accent);
    transform: translateX(3px);
    opacity: 1;
  }

  .work-thumb {
    flex: 0 0 auto;
    width: 76px; height: 50px;
    border-radius: 5px; overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }
  .work-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .work-body { flex: 1; min-width: 0; }
  .work-title { display: block; font-weight: 600; font-size: 0.95rem; }
  .work-sum {
    display: block; margin-top: 0.15rem;
    font-size: 0.84rem; color: var(--color-text-muted); line-height: 1.45;
  }
  .work-arrow { flex: 0 0 auto; color: var(--color-text-muted); transition: color 0.2s; }
  .work-row:hover .work-arrow { color: var(--color-accent); }

  @media (max-width: 520px) {
    .work-thumb { display: none; }
  }

  /* ---- Skills ---- */
  .skills-section h2 { margin-bottom: 1.5rem; }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .skill-group {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .skill-group h3 {
    font-size: 0.9rem;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .skill-group p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
