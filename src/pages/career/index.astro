---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import site from '../../data/site.json';

const work = (site as any).work ?? { heading: 'Work Experience', intro: '', terms: [] };
const terms: any[] = work.terms ?? [];

const entries = (await getCollection('posts'))
  .filter((p) => p.data.type === 'work')
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const rendered = await Promise.all(
  entries.map(async (e) => ({ entry: e, Content: (await e.render()).Content }))
);

function monthsBetween(start: string, end: string) {
  const [sy, sm] = String(start).split('-').map(Number);
  const [ey, em] = String(end).split('-').map(Number);
  return Math.max(1, (ey - sy) * 12 + (em - sm) + 1);
}
const termMonths = (t: any) =>
  Number(t.months) > 0 ? Number(t.months) : monthsBetween(t.start, t.end);

const MONTH = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function label(ym: string) {
  const [y, m] = String(ym).split('-').map(Number);
  return MONTH[(m || 1) - 1] + ' ' + y;
}

const bands = terms
  .slice()
  .sort((a, b) => String(b.start).localeCompare(String(a.start)))
  .map((t) => ({
    term: t,
    items: rendered.filter((r) => r.entry.data.term === t.id),
    months: termMonths(t),
  }));

const orphans = rendered.filter((r) => !terms.some((t) => t.id === r.entry.data.term));
const totalMonths = terms.reduce((n, t) => n + termMonths(t), 0);
const longestTerm = Math.max(1, ...terms.map(termMonths));
---

<BaseLayout title="Career" description="Wyatt Shore — engineering co-op work experience">
  <div class="container--wide xp">
    <header class="xp-header">
      <h1>{work.heading}</h1>
      {work.intro && <p class="xp-intro">{work.intro}</p>}
      {totalMonths > 0 && (
        <p class="xp-stat">
          <strong>{totalMonths} months</strong> of co-op experience across {terms.length} terms
        </p>
      )}
    </header>

    {bands.length === 0 ? (
      <div class="xp-empty">
        <p>No work terms configured yet — add them in the Portfolio Editor under
        <strong>Site Settings → Work timeline</strong>.</p>
      </div>
    ) : (
      <div class="timeline" id="timeline">
        {bands.map(({ term, items, months }) => (
          <section class="band" data-months={months} style={`--band-months:${months}`}>
            <div class="rail" aria-hidden="true">
              <span class="rail-line"></span>
              <span class="rail-cap top"></span>
              <span class="rail-cap bottom"></span>
            </div>

            <div class="band-body">
              <header class="band-head">
                <div class="band-dates">
                  <span class="from">{label(term.start)}</span>
                  <span class="to">{label(term.end)}</span>
                  <span class="dur">{months} mo</span>
                </div>
                <div
                  class="band-bar"
                  title={`${months} months of ${longestTerm} at the longest term`}
                  aria-hidden="true"
                >
                  <span class="band-bar-fill" style={`width:${(months / longestTerm) * 100}%`}></span>
                </div>
                <h2>{term.role}</h2>
                <p class="band-org">
                  {term.company}{term.location && <span class="band-loc"> · {term.location}</span>}
                </p>
                {term.blurb && <p class="band-blurb">{term.blurb}</p>}
              </header>

              {items.length > 0 ? (
                <div class="items">
                  {items.map(({ entry, Content }) => (
                    <details class="item" id={`entry-${entry.slug}`}>
                      <summary>
                        <span class="node" aria-hidden="true"></span>
                        {entry.data.featureImage && (
                          <span class="item-thumb">
                            <img src={entry.data.featureImage} alt="" loading="lazy" />
                          </span>
                        )}
                        <span class="item-text">
                          <span class="item-title">{entry.data.title}</span>
                          {(entry.data.summary || entry.data.description) && (
                            <span class="item-summary">
                              {entry.data.summary || entry.data.description}
                            </span>
                          )}
                        </span>
                        <span class="chev" aria-hidden="true">›</span>
                      </summary>
                      <div class="item-body">
                        {entry.data.featureImage && (
                          <figure class="item-cover">
                            <img src={entry.data.featureImage} alt={entry.data.title} loading="lazy" />
                          </figure>
                        )}
                        {entry.data.tags.length > 0 && (
                          <div class="item-tags">
                            {entry.data.tags.map((t) => <span class="tag">{t}</span>)}
                          </div>
                        )}
                        <div class="prose post-content"><Content /></div>
                      </div>
                    </details>
                  ))}
                </div>
              ) : (
                <p class="band-none">No entries published for this term yet.</p>
              )}
            </div>
          </section>
        ))}

        {orphans.length > 0 && (
          <section class="band" data-months="2" style="--band-months:2">
            <div class="rail" aria-hidden="true"><span class="rail-line"></span></div>
            <div class="band-body">
              <header class="band-head"><h2>Other work</h2></header>
              <div class="items">
                {orphans.map(({ entry, Content }) => (
                  <details class="item" id={`entry-${entry.slug}`}>
                    <summary>
                      <span class="node" aria-hidden="true"></span>
                      {entry.data.featureImage && (
                        <span class="item-thumb">
                          <img src={entry.data.featureImage} alt="" loading="lazy" />
                        </span>
                      )}
                      <span class="item-text">
                        <span class="item-title">{entry.data.title}</span>
                        {(entry.data.summary || entry.data.description) && (
                          <span class="item-summary">{entry.data.summary || entry.data.description}</span>
                        )}
                      </span>
                      <span class="chev" aria-hidden="true">›</span>
                    </summary>
                    <div class="item-body">
                      {entry.data.featureImage && (
                        <figure class="item-cover">
                          <img src={entry.data.featureImage} alt={entry.data.title} loading="lazy" />
                        </figure>
                      )}
                      <div class="prose post-content"><Content /></div>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    // Deep links: /career#entry-<slug> opens and scrolls to that entry.
    function openFromHash() {
      var id = (location.hash || '').replace('#', '');
      if (!id) return;
      var el = document.getElementById(id);
      if (el && el.tagName.toLowerCase() === 'details') {
        el.open = true;
        el.scrollIntoView({ block: 'center' });
      }
    }
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  })();
</script>

<style>
  .xp { padding-top: 4rem; padding-bottom: 6rem; }

  .xp-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .xp-header h1 { margin-bottom: 0.75rem; }
  .xp-intro { color: var(--color-text-muted); max-width: 62ch; font-size: 1.05rem; margin: 0; }
  .xp-stat { margin: 1rem 0 0; font-size: 0.85rem; color: var(--color-text-muted); }
  .xp-stat strong { color: var(--color-accent); }

  .xp-empty {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .timeline { display: flex; flex-direction: column; }

  /* Bands are sized by their content. Duration is shown exactly, but
     horizontally (see .band-bar) — drawing it vertically forced a long, sparse
     term to be mostly empty space. */
  .band {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 0 1.5rem;
    padding-bottom: 2.75rem;
  }

  .rail { position: relative; }
  .rail-line {
    position: absolute;
    left: 50%; top: 0.55rem; bottom: -2.75rem;
    width: 2px; transform: translateX(-50%);
    background: linear-gradient(to bottom, var(--color-accent) 0, var(--color-accent) 60%, var(--color-border) 100%);
    opacity: 0.55;
  }
  .band:last-child .rail-line { bottom: 0; }

  .rail-cap {
    position: absolute;
    left: 50%; width: 11px; height: 11px;
    border-radius: 50%; transform: translateX(-50%);
    background: var(--color-bg); border: 2px solid var(--color-accent);
  }
  .rail-cap.top { top: 0; }
  .rail-cap.bottom { bottom: -2.75rem; }
  .band:last-child .rail-cap.bottom { display: none; }

  .band-head { margin-bottom: 1.1rem; }
  .band-dates {
    display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;
    font-size: 0.78rem; color: var(--color-text-muted); margin-bottom: 0.35rem;
  }
  .band-dates .to::before { content: '– '; }
  .band-dates .dur {
    border: 1px solid var(--color-border);
    background: var(--color-accent-dim);
    color: var(--color-accent);
    border-radius: 999px; padding: 0.05rem 0.5rem;
    font-size: 0.72rem; font-weight: 600;
  }
  .band-bar {
    height: 4px;
    width: min(260px, 100%);
    border-radius: 999px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    overflow: hidden;
    margin: 0 0 0.6rem;
  }
  .band-bar-fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
    opacity: 0.8;
    border-radius: 999px;
  }

  .band-head h2 { font-size: 1.15rem; margin: 0 0 0.15rem; }
  .band-org { margin: 0; font-size: 0.92rem; color: var(--color-text); }
  .band-loc { color: var(--color-text-muted); }
  .band-blurb { margin: 0.5rem 0 0; font-size: 0.9rem; color: var(--color-text-muted); max-width: 62ch; }
  .band-none { font-size: 0.85rem; color: var(--color-text-muted); font-style: italic; margin: 0; }

  .items { display: flex; flex-direction: column; gap: 0.6rem; }

  .item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 0.2s;
    scroll-margin-top: 80px;
  }
  .item:hover, .item[open] { border-color: var(--color-accent); }

  .item summary {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.9rem 1rem; cursor: pointer; list-style: none;
  }
  .item summary::-webkit-details-marker { display: none; }
  .item summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px; border-radius: var(--radius);
  }

  .node {
    width: 9px; height: 9px; border-radius: 50%;
    flex: 0 0 auto; background: var(--color-accent); opacity: 0.75;
    margin-left: -1.75rem; align-self: flex-start; margin-top: 0.42rem;
  }

  /* Optional cover image — entries without one keep the plain text layout. */
  .item-thumb {
    flex: 0 0 auto;
    width: 88px; height: 58px;
    border-radius: 5px; overflow: hidden;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }
  .item-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .item summary .item-text { flex: 1; min-width: 0; }
  .item-title { display: block; font-weight: 600; font-size: 0.97rem; line-height: 1.35; }
  .item-summary {
    display: block; margin-top: 0.2rem; font-size: 0.85rem;
    color: var(--color-text-muted); line-height: 1.45;
  }

  .chev {
    flex: 0 0 auto; color: var(--color-text-muted);
    font-size: 1.15rem; line-height: 1;
    transition: transform 0.2s, color 0.2s;
  }
  .item[open] .chev { transform: rotate(90deg); color: var(--color-accent); }
  .item:hover .chev { color: var(--color-accent); }

  .item-body {
    padding: 0 1rem 1.1rem 1rem;
    border-top: 1px solid var(--color-border);
    margin-top: -1px;
  }
  .item-cover {
    margin: 1rem 0 0;
    border-radius: 6px; overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }
  .item-cover img { width: 100%; display: block; max-height: 420px; object-fit: cover; }
  .item-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; padding-top: 0.9rem; }
  /* .post-content carries the shared figure / size / align / table styles from
     global.css, so images in a work entry behave exactly as in a project post. */
  .prose { padding-top: 0.9rem; font-size: 0.93rem; }
  .prose :global(> :first-child) { margin-top: 0; }
  .prose :global(> :last-child) { margin-bottom: 0; }
  .prose :global(figure) { margin: 1.25rem 0; }
  .prose :global(figure img) { margin: 0 auto; }

  @media (max-width: 700px) {
    .xp { padding-top: 2.5rem; }
    .band {
      grid-template-columns: 22px 1fr;
      gap: 0 0.9rem;
      min-height: 0;
      padding-bottom: 2rem;
    }
    .rail-line { bottom: -2rem; }
    .rail-cap.bottom { bottom: -2rem; }
    .node { margin-left: 0; }
    .items { display: block; }
    .items > .item + .item { margin-top: 0.6rem; }
    .item summary { padding: 0.8rem 0.85rem; gap: 0.6rem; }
    .item-thumb { width: 64px; height: 44px; }
    .item-body { padding: 0 0.85rem 1rem; }
  }
</style>
