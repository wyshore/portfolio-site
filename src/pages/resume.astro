---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const resume = (site as any).resume ?? {};
const file: string = resume.file || '/resume/Wyatt_Shore_Resume.pdf';

// Build-time check so the page degrades gracefully instead of showing a dead embed.
const diskPath = path.join(process.cwd(), 'public', file.replace(/^\//, ''));
const exists = fs.existsSync(diskPath);
const sizeKb = exists ? Math.round(fs.statSync(diskPath).size / 1024) : 0;

const updated: string = resume.updated || '';
const showUpdated: boolean = resume.showUpdated !== false && !!updated;
const note: string = resume.note || '';

const prettyUpdated = updated
  ? new Date(updated + 'T00:00:00').toLocaleDateString('en-CA', {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : '';
---

<BaseLayout title="Resume" description="Wyatt Shore — mechanical engineering resume">
  <div class="container resume-page">
    <header class="resume-header">
      <div>
        <h1>Resume</h1>
        {note && <p class="resume-note">{note}</p>}
        {showUpdated && <p class="resume-updated">Last updated {prettyUpdated}</p>}
      </div>

      {exists && (
        <a href={file} download class="btn-download">
          <span aria-hidden="true">↓</span> Download PDF
          <span class="size">{sizeKb} KB</span>
        </a>
      )}
    </header>

    {exists ? (
      <>
        <div class="resume-viewer">
          <object data={file} type="application/pdf" aria-label="Wyatt Shore resume">
            <div class="viewer-fallback">
              <p>Your browser can't display the PDF inline.</p>
              <a href={file} download class="btn-download">↓ Download PDF</a>
            </div>
          </object>
        </div>

        <div class="resume-mobile">
          <div class="mobile-card">
            <div class="doc-icon" aria-hidden="true">PDF</div>
            <h2>Wyatt Shore — Resume</h2>
            <p>Best viewed as a download on mobile.</p>
            <a href={file} download class="btn-download full">↓ Download PDF ({sizeKb} KB)</a>
            <a href={file} target="_blank" rel="noopener" class="btn-secondary full">Open in a new tab</a>
          </div>
        </div>
      </>
    ) : (
      <div class="resume-missing">
        <h2>No resume uploaded yet</h2>
        <p>
          Upload a PDF in the Portfolio Editor under <strong>Site Settings → Resume</strong>,
          then publish.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .resume-page { padding-top: 4rem; padding-bottom: 6rem; }

  .resume-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .resume-header h1 { margin: 0; }

  .resume-note {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    max-width: 48ch;
  }
  .resume-updated {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-accent);
    color: #0d1117;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius);
    transition: opacity 0.2s, transform 0.2s;
    white-space: nowrap;
  }
  .btn-download:hover { opacity: 0.85; transform: translateY(-1px); }
  .btn-download .size {
    font-weight: 500;
    font-size: 0.78rem;
    opacity: 0.7;
  }
  .btn-download.full,
  .btn-secondary.full {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius);
    transition: background 0.2s;
  }
  .btn-secondary:hover { background: var(--color-surface-2); }

  /* ---- desktop viewer ---- */
  .resume-viewer {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
    height: min(1100px, 125vh);
  }
  .resume-viewer object {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }
  .viewer-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    height: 100%;
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ---- mobile card ---- */
  .resume-mobile { display: none; }
  .mobile-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 2rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }
  .mobile-card h2 { margin: 0.25rem 0 0; font-size: 1.1rem; }
  .mobile-card p { margin: 0 0 0.5rem; color: var(--color-text-muted); font-size: 0.9rem; }
  .doc-icon {
    width: 54px; height: 54px;
    display: grid; place-items: center;
    border-radius: 10px;
    background: var(--color-accent-dim);
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    border: 1px solid var(--color-border);
  }

  .resume-missing {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--color-text-muted);
  }
  .resume-missing h2 { margin: 0 0 0.5rem; color: var(--color-text); font-size: 1.1rem; }

  @media (max-width: 820px) {
    .resume-page { padding-top: 2.5rem; }
    .resume-viewer { display: none; }
    .resume-mobile { display: block; }
    .resume-header { gap: 1rem; }
    .resume-header .btn-download { display: none; }
  }
</style>
