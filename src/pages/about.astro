---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const about = site.about;
---

<BaseLayout title="About" description={about.pageDescription}>
  <div class="container" style="padding-top: 4rem; padding-bottom: 6rem;">
    <div class="about-hero">
      <div class="about-photo">
        <img src={about.photo} alt={site.hero.name} />
      </div>
      <div class="about-intro">
        <h1>{about.heading}</h1>
        <p class="lead">
          {about.lead}
        </p>
        {about.paragraphs.map(p => (
          <p set:html={p}></p>
        ))}
        <div class="about-links">
          {about.links.map(link => (
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener' : undefined}
              class="about-link"
            >{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <hr />

    <section class="about-section">
      <h2>{about.cardsHeading}</h2>
      <div class="about-grid">
        {about.cards.map(card => (
          <div class="about-card">
            <div class="about-card-icon"></div>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        ))}
      </div>
    </section>

    <hr />

    <section class="about-section">
      <h2>{about.photosHeading}</h2>
      <div class="photo-collage">
        {about.photos.map(photo => (
          <div class={`photo-tile tile-${photo.size}`}><img src={photo.src} alt="" loading="lazy" /></div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  @media (max-width: 640px) {
    .about-hero { grid-template-columns: 1fr; }
    .about-photo { width: 140px; }
  }

  .about-photo {
    width: 240px;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid var(--color-border);
  }

  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  h1 { margin-bottom: 1rem; }

  .lead {
    font-size: 1.1rem;
    color: #ccc;
    margin-bottom: 1rem;
  }

  .about-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .about-link {
    display: inline-block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text);
    transition: border-color 0.2s, color 0.2s;
  }

  .about-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
  }

  .about-section { margin: 3rem 0; }
  .about-section h2 { margin-bottom: 1.5rem; }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .about-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .about-card-icon { font-size: 1.5rem; margin-bottom: 0.5rem; }

  .about-card h3 {
    font-size: 0.95rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .about-card p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Photo collage — varied tiles for visual interest */
  .photo-collage {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: 0.75rem;
  }

  .photo-tile {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
    grid-column: span 1;
    grid-row: span 1;
  }
  .photo-tile.tile-wide { grid-column: span 2; }
  .photo-tile.tile-tall { grid-row: span 2; }
  .photo-tile.tile-large { grid-column: span 2; grid-row: span 2; }

  .photo-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .photo-tile:hover img { transform: scale(1.05); }

  @media (max-width: 800px) {
    .photo-collage {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }
    .photo-tile.tile-wide,
    .photo-tile.tile-large { grid-column: span 2; grid-row: span 1; }
    .photo-tile.tile-tall { grid-row: span 2; }
  }
</style>
